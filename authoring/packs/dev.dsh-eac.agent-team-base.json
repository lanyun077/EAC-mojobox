      "ref": "dshmarket",
      "version": "1.66.8"
    },
    {
      "ref": "dsh-context",
      "version": "0.62.3"
    },
    {
      "ref": "dsh-session-manager",
      "version": "0.6.2"
    },
    {
      "ref": "dsh-undo-savepoint",
      "version": "0.4.10"
    },
    {
      "ref": "dsh-better-sidebar",
      "version": "0.24.1"
    },
    {
      "ref": "@vlln/dsh-navbar",
      "version": "0.4.0"
    },
    {
      "ref": "github:00080000/dsh-project-memory",
      "version": "0.5.14"
    },
    {
      "ref": "@nanmicoder/dsh-agent-teams",
      "version": "0.1.22"
    }
  ],
  "conflicts": [
