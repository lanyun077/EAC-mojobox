  "author": "DSH-EAC",
  "license": "MIT",
  "requires": {
    "dsh": "0.2.2-rc.1"
  },
  "plugins": [
    {
      "ref": "dshmarket",
      "version": "1.73.17"
    },
    {
      "ref": "dsh-context",
      "version": "0.83.1"
    },
    {
      "ref": "dsh-session-manager",
      "version": "0.7.5"
    },
    {
      "ref": "dsh-undo-savepoint",
      "version": "0.5.1"
    },
    {
      "ref": "dsh-better-sidebar",
      "version": "0.30.1"
    },
    {
      "ref": "@vlln/dsh-navbar",
      "version": "0.4.0"
    },
    {
      "ref": "@nagi-ovo/dsh-visualize",
      "version": "0.1.9"
    }
  ],
  "conflicts": [
    "dsh-unified-market",
    "dsh-find-plugin",
    "@changfenhuang/dsh-genui",
    "dsh-drag-and-drop",
    "dsh-file-drop-eac"
  ],
  "overrides": [],
  "changelog": "2026-11-11：更新公开组件发行，以官版 DSH 0.2.2-rc.1 为本组合的精确选型目标；已核验原始 npm 身份、integrity、SHA-256 和官方静态版本规则，未安装运行。保留既有组合与互斥策略；MIT 仅覆盖自编清单。完整来源、许可和升级条件见 docs/catalog-update-20261111.md。"
}
