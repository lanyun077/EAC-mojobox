{
  "formatVersion": 1,
  "id": "dev.dsh-eac.suite-lite",
  "name": "DSH 日常减重版",
  "version": "0.4.0",
  "description": "包含插件市场、上下文面板、会话管理、快照恢复、文件开发侧栏和交互可视化六项工具。支持查找插件、整理会话、编辑文件、查看 Git 与 AI 改动、定位长对话和展示交互结果，适合日常对话与开发。",
  "author": "DSH-EAC",
  "license": "MIT",
  "requires": {
    "dsh": "0.2.2-rc.5"
  },
  "plugins": [
    {
      "ref": "dshmarket",
      "version": "1.75.0"
    },
    {
      "ref": "dsh-context",
      "version": "0.87.0"
    },
    {
      "ref": "dsh-session-manager",
      "version": "0.7.11"
    },
    {
      "ref": "dsh-undo-savepoint",
      "version": "0.5.1"
    },
    {
      "ref": "dsh-better-sidebar",
      "version": "0.32.1"
    },
    {
      "ref": "@nagi-ovo/dsh-visualize",
      "version": "0.1.10"
    }
  ],
  "conflicts": [
    "dsh-unified-market",
    "dsh-find-plugin",
    "@changfenhuang/dsh-genui",
    "dsh-drag-and-drop",
    "dsh-file-drop-eac"
  ],
  "overrides": [],
  "changelog": "2026-11-21：更新插件精确发行与官版 0.2.2-rc.5 目标，完善组件及用途说明。"
}
