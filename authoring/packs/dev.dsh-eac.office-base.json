  },
  "plugins": [
    {
      "ref": "dshmarket",
      "version": "1.75.0"
    },
    {
      "ref": "dsh-context",
      "version": "0.87.0"
    },
    {
      "ref": "dsh-session-manager",
      "version": "0.7.11"
    },
    {
      "ref": "dsh-undo-savepoint",
      "version": "0.5.1"
    },
    {
      "ref": "dsh-better-sidebar",
      "version": "0.32.1"
    },
    {
      "ref": "dsh-univer-office",
      "version": "0.5.1"
    },
    {
      "ref": "@changfenhuang/dsh-genui",
      "version": "0.16.0"
    }
  ],
  "conflicts": [
    "dsh-unified-market",
    "dsh-find-plugin",
    "@nagi-ovo/dsh-visualize",
    "dsh-drag-and-drop",
    "dsh-file-drop-eac"
  ],
