{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Mojobox website-only resource classification",
  "type": "object", "additionalProperties": false, "required": ["entries"],
  "properties": {
    "entries": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["type", "id"],
        "anyOf": [{ "required": ["officialTags"] }, { "required": ["customTags"] }],
        "properties": {
          "type": { "enum": ["pack", "skin-prompt"] },
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
          "officialTags": {
            "type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" }
          },
          "customTags": {
            "type": "array", "minItems": 1, "maxItems": 12, "uniqueItems": true,
            "items": { "type": "string", "minLength": 1, "maxLength": 32, "pattern": "\\S" }
          }
        }
      }
    }
  }
}
