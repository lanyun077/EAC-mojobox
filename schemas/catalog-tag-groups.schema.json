{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Mojobox official website tag groups",
  "type": "object", "additionalProperties": false, "required": ["packs", "skins"],
  "properties": {
    "packs": { "$ref": "#/definitions/group" },
    "skins": { "$ref": "#/definitions/group" }
  },
  "definitions": {
    "text": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "\\S" },
    "group": {
      "type": "array", "minItems": 1, "maxItems": 8,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "label", "description", "aliases"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" },
          "label": { "$ref": "#/definitions/text" },
          "description": { "$ref": "#/definitions/text" },
          "aliases": { "type": "array", "maxItems": 6, "uniqueItems": true, "items": { "$ref": "#/definitions/text" } }
        }
      }
    }
  }
}
